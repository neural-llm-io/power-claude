{
  "schema": "hurc-complete-e2e-runtime/v1",
  "description": "List (inventory) + live execute-consumer + fail-closed prove-receipt adapters for power-claude consumer e2e.",
  "adapters": [
    {
      "id": "power-claude-list-surfaces",
      "kind": "cli",
      "surface_kind": "cli",
      "timeout_sec": 30,
      "argv": ["python3", "scripts/complete-e2e/list-surfaces.py"]
    },
    {
      "id": "power-claude-execute-consumer",
      "kind": "cli",
      "surface_kind": "cli",
      "timeout_sec": 300,
      "argv": ["python3", "scripts/complete-e2e/execute-consumer.py"]
    },
    {
      "id": "power-claude-prove-receipt",
      "kind": "prover",
      "surface_kind": "cli",
      "timeout_sec": 300,
      "fail_closed_on_unreachable": true,
      "argv": ["python3", "scripts/complete-e2e/prove.py", "--receipt"]
    }
  ]
}
